<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Authors>CEM</Authors>
        <AssemblyName>PositiveConnections</AssemblyName>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>preview</LangVersion>
        <OutDir>..\1.5\Assemblies\</OutDir>
        <BaseIntermediateOutputPath>obj\1.5\</BaseIntermediateOutputPath>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <Optimize>true</Optimize>
        <EnableNETAnalyzers>True</EnableNETAnalyzers>
        <AnalysisLevel>preview-all</AnalysisLevel>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>5</WarningLevel>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <DefineConstants>$(DefineConstants);V15</DefineConstants>
        <ReleaseVersion>1.5</ReleaseVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="1.5.*" />
        <PackageReference Include="Lib.Harmony" Version="2.*" ExcludeAssets="runtime" />
    </ItemGroup>

    <Import Project="PositiveConnections.sources.props" />

    <ItemGroup>
        <None Remove=".gitignore" />
    </ItemGroup>
</Project>
